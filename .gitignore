# ===== Large files: not tracked =====
# System images (2.7 GB each); checksums are recorded in IMAGES.md
output/*.img
output/*.7z
output/*.tmp

# Base-board images / Debian original image
images/*.img
# Vendor build-tool copy (contains its own .git; keeps it from becoming a submodule)
debian12/

# Kernel source tree (1.9 GB); only the modified files are kept under kernel/
work/

# Backup archives
backup/

# ===== Sensitive data =====
ssh.txt

# ===== baka build artefacts (see cirno/baka-project/README.md) =====
cirno/baka-project/baka
cirno/baka-project/*.7z

# ===== Temporary / cache =====
*.log
*.tmp
.tmp/
_alpindroid/
kernel/_tmp

# PowerShell scratch scripts
*.ps1.bak

# OS clutter
Thumbs.db
desktop.ini
.DS_Store
# Tool state directory (not project content)
.reasonix/

# Source tree generated by setup-kernel.sh
build/
