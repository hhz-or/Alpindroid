# ===== 大文件：不进版本库 =====
# 系统镜像（2.7 GB/个），用 SHA256 记录在 IMAGES.md
output/*.img
output/*.7z
output/*.tmp

# 底板镜像 / Debian 原始镜像
images/*.img
# 厂商构建工具副本（内含 .git，避免被当子模块）
debian12/

# 内核源码树（1.9 GB），只保留修改过的文件在 kernel/
work/

# 备份归档
backup/

# ===== 敏感信息 =====
ssh.txt

# ===== 临时/缓存 =====
*.log
*.tmp
.tmp/
_alpindroid/
kernel/_tmp

# PowerShell 临时脚本
*.ps1.bak

# 系统垃圾
Thumbs.db
desktop.ini
.DS_Store
# 工具状态目录（非项目内容）
.reasonix/

# setup-kernel.sh 生成的源码树
build/
