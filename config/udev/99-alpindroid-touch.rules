# Alpindroid — bind generic touchscreens to the HDMI output
#
# The WalnutPi ZeroW panel is a plain USB HID multi-touch device
# (OpenWare Multi-Touch-V5000, vendor 222a product 0001). The kernel
# hid-multitouch driver creates an MT-B input node with INPUT_PROP_DIRECT,
# libinput picks it up, and Weston maps its coordinates onto the output
# named in WL_OUTPUT. Without this binding Weston only associates the
# touchscreen with whatever output happens to be enabled first, which breaks
# as soon as a second head (or DPMS off) is involved.
#
# Install to /etc/udev/rules.d/99-alpindroid-touch.rules and reload udev:
#   udevadm control --reload && udevadm trigger --subsystem-match=input
#
# The match is on ID_INPUT_TOUCHSCREEN, which the input_id builtin sets for any
# device libinput would treat as a touchscreen, so it is not tied to one
# specific panel.

ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TOUCHSCREEN}=="1", ENV{WL_OUTPUT}="HDMI-A-1"
